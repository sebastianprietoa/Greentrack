{
  "schema_version": "1.0.0",
  "created_at": "2026-09-23",
  "purpose": "Energy factor registry for a Chile-focused application calculating carbon footprint and upstream freshwater supply footprint from energy consumption in multiple units.",
  "implementation_policy": {
    "preserve_existing_carbon_registry": true,
    "water_footprint_indicator": "Freshwater upstream from SimaPro Selected LCI results, additional V1.08",
    "do_not_use_aware_as_physical_water": true,
    "do_not_use_burned_in_for_supply_water": true,
    "block_unsupported_unit_conversions": true,
    "block_requires_blend_and_requires_waste_model": true,
    "electricity_carbon_factor_must_be_selected_by_reporting_year": true,
    "water_output_unit": "m3",
    "carbon_output_unit_preferred": "kgCO2e"
  },
  "generic_unit_rules": {
    "t_to_kg": 1000,
    "kg_to_t": 0.001,
    "m3_to_L": 1000,
    "L_to_m3": 0.001,
    "gal_us_to_L": 3.785411784,
    "MWh_to_kWh": 1000,
    "kWh_to_MWh": 0.001,
    "GJ_to_MJ": 1000,
    "MJ_to_GJ": 0.001,
    "kWh_to_MJ": 3.6,
    "MWh_to_GJ": 3.6,
    "fuel_specific_formulas": {
      "L_to_kg": "kg = L * density_kg_per_L",
      "m3_to_kg": "kg = m3 * 1000 * density_kg_per_L",
      "GJ_to_kg": "kg = GJ * 1000 / PCS_MJ_per_kg",
      "MJ_to_kg": "kg = MJ / PCS_MJ_per_kg",
      "GJ_to_m3": "m3 = GJ * 1000 / PCS_MJ_per_m3"
    }
  },
